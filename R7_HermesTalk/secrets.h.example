/*
 * Copy this file to secrets.h (same folder) and fill in your own values.
 * secrets.h is private: do not commit, share, or paste it into a chat.
 *
 * Token: at least 16 characters. One way to make one on the Mac:
 *   openssl rand -hex 24
 * Store the same token in the macOS Keychain for Hermes in the next step.
 *
 * R7b hold-to-talk: HERMES_HOOK_HOST is the Mac running the Hermes gateway, as its
 * Bonjour name ("<LocalHostName>.local", see: scutil --get LocalHostName) or a fixed IP.
 * HERMES_HOOK_SECRET is the robot-voice route's secret, the same value as
 * STACKCHAN_WEBHOOK_SECRET in ~/.hermes/.env (Keychain: stackchan-webhook-secret).
 */
#pragma once

#define WIFI_SSID           "your-home-wifi-name"
#define WIFI_PASSWORD       "your-home-wifi-password"
#define HERMES_STATUS_TOKEN "REPLACE_WITH_A_LONG_RANDOM_TOKEN"
#define HERMES_HOOK_HOST    "your-mac.local"
#define HERMES_HOOK_SECRET  "REPLACE_WITH_THE_GATEWAY_ROUTE_SECRET"
